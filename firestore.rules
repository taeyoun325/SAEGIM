rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 관리자 여부. admins/{uid} 문서가 존재하면 관리자다.
    // 이 문서는 Admin SDK(scripts/set-admin.js)로만 만들 수 있어 클라이언트가 스스로 승격할 수 없다.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 게시물이 이미 사라졌는지. 게시물에 딸린 좋아요/저장/댓글은 "누른 사람"이 남이라
    // 평소엔 각자 본인 것만 지울 수 있는데, 글이 삭제되면 그 문서들은 가리킬 대상이 없는
    // 고아 데이터가 되므로 누구든 정리할 수 있어야 한다(안 그러면 영원히 남는다).
    //
    // "글 주인이면 허용"이 아니라 "글이 이미 없으면 허용"인 것이 핵심이다 — 전자로 하면
    // 글이 살아있는 동안 주인이 남의 좋아요·댓글을 골라 지울 수 있게 되어버린다
    // (e2e "타인 좋아요/댓글 삭제 차단" 검증이 이걸 막는다).
    // 따라서 삭제 코드는 반드시 게시물을 먼저 지우고 딸린 문서를 정리해야 한다.
    function postGone(postId) {
      return !exists(/databases/$(database)/documents/posts/$(postId));
    }

    // 댓글에 대해서도 같은 원리. 댓글이 지워지면 거기 달린 좋아요와 답글은 고아가 되므로
    // 그때만 정리를 허용한다(댓글이 살아있는 동안은 여전히 본인 것만 지울 수 있다).
    function commentGone(commentId) {
      return !exists(/databases/$(database)/documents/comments/$(commentId));
    }

    // 관리자 명단: 아무도 클라이언트에서 쓰지 못한다. 본인 문서만 읽어 관리자인지 확인할 수 있다.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── 도배 방지 ────────────────────────────────────────────────────────────
    // 보안 규칙은 요청마다 상태가 없으므로, "마지막으로 언제 했는지"를 문서에 남겨 쿨다운을 건다.
    // 핵심은 클라이언트가 시각을 위조하지 못하게 하는 것: 반드시 서버 시각(request.time)만 쓸 수 있다.
    // 액션별로 문서를 따로 둬(단일 필드 전체 덮어쓰기) merge로 인한 판정 모호함을 없앤다.
    // delete를 허용하면 쿨다운 기록을 지워 우회할 수 있으므로 create/update만 연다.
    // (계정 삭제 시 이 문서는 남지만, uid가 재사용되지 않아 문제되지 않는다.)
    match /rateLimits/{uid}/actions/{action} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // 같은 배치(원자적 커밋) 안에서 쿨다운 문서가 "지금"으로 갱신되었고,
    // 직전 기록이 cooldownSeconds보다 오래됐을 때만 통과한다.
    // getAfter = 커밋 후 상태, get = 커밋 전 상태. 첫 시도는 문서가 없으므로 통과한다.
    function withinCooldown(action, cooldownSeconds) {
      let path = /databases/$(database)/documents/rateLimits/$(request.auth.uid)/actions/$(action);
      return getAfter(path).data.at == request.time
        && (!exists(path)
            || get(path).data.at < request.time - duration.value(cooldownSeconds, 's'));
    }
    // ─────────────────────────────────────────────────────────────────────────

    // 글감: 관리자만 생성/수정할 수 있다(관리자 대시보드에서 추가). 클라이언트는 읽기만.
    match /prompts/{promptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사용자 프로필: 본인만 쓰기, 로그인한 사용자는 공개 프로필 필드를 읽을 수 있음.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // 일회용 로그인 코드: 이메일이 없는 사용자(학생 등)에게 5자리 코드만 나눠주고,
    // 그 코드가 미리 만들어둔 계정의 이메일/비밀번호를 가리키게 한다.
    // list는 관리자만 허용해(발급 현황 확인용) 일반 사용자가 코드를 순회로 알아낼 수
    // 없게 하고, get은 코드를 이미 아는 사람만(로그인 전이라도) 문서 ID로 직접
    // 조회할 수 있어야 해서 열어둔다.
    // 문서 생성은 Admin SDK 발급 스크립트만 하고, 클라이언트는 로그인 성공 직후
    // claimed를 false→true로 정확히 한 번만 바꿀 수 있다(이메일/비밀번호는 못 바꿈).
    match /loginCodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.password == resource.data.password;
      allow delete: if false;
    }

    // 닉네임 예약: 문서 ID(소문자 닉네임)가 유니크 제약 역할을 한다.
    // 아무도 이미 예약된 문서를 덮어쓸 수 없고, 본인 예약만 해제(계정 삭제 시)할 수 있다.
    match /nicknames/{nicknameKey} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 관리자가 신고된 글을 지울 때 postService.deletePost가 원본 writing을
    // 비공개로 되돌리고 postId 연결을 끊는다(작성자 본인이 지울 때와 같은 마무리 단계).
    // 이 필드 두 개만 정확히 그 값으로 바뀌는 요청만 허용하고, 본문/작성자 등은 절대 못 바꾸게 한다
    // — 관리자가 남의 비공개 글 내용을 고쳐 쓰는 길을 열어주지 않기 위해서다.
    function adminResettingWritingVisibility() {
      return isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.promptId == resource.data.promptId
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.visibility == 'private'
        && request.resource.data.postId == null;
    }

    // 글(Writing): 비공개 글은 작성자만 조회, 본인 글만 생성/수정.
    // 생성은 60초 쿨다운. 앱은 글감당 한 편만 쓰게 하지만, 규칙만으로는 그걸 강제할 수 없어
    // (쿼리를 못 하므로) 최소한 스크립트로 대량 생성하는 것을 막는다.
    match /writings/{writingId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && withinCooldown('writing', 60);
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || adminResettingWritingVisibility());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 게시물: 공개 콘텐츠이므로 로그인한 사용자는 모두 읽기 가능. 본인만 생성/삭제.
    // 업데이트는 likeCount/commentCount를 ±1 하는 것만 허용하고 나머지 필드는 불변으로 강제한다.

    // ±1 제약만으로는 "좋아요를 누르지 않고 카운트만 1씩 계속 올리는" 조작을 막지 못한다.
    // 좋아요 문서 id는 `${postId}_${uid}`로 정해져 있어 규칙에서 경로를 계산할 수 있으므로,
    // 내 좋아요 문서가 실제로 생겼는지(취소했는지)를 커밋 후 상태(existsAfter)로 확인한다.
    // 앱은 좋아요 문서 쓰기와 카운트 갱신을 같은 트랜잭션에서 하므로 이 검사를 통과한다.
    function likeDeltaBackedByLikeDoc(postId) {
      let likePath = /databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid);
      let delta = request.resource.data.likeCount - resource.data.likeCount;
      return delta == 0
        || (delta == 1 && !exists(likePath) && existsAfter(likePath))
        || (delta == -1 && exists(likePath) && !existsAfter(likePath));
    }

    // 댓글 수는 댓글 문서 id가 자동 생성이라 규칙에서 경로를 알 수 없어 같은 방식으로
    // 검증할 수 없다. 대신 댓글 생성에 15초 쿨다운이 걸려 있어 대량 조작이 제한된다.
    function commentCountDeltaAllowed() {
      return request.resource.data.commentCount - resource.data.commentCount == 1
        || request.resource.data.commentCount - resource.data.commentCount == -1
        || request.resource.data.commentCount == resource.data.commentCount;
    }

    function onlyCountersChanged(postId) {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.writingId == resource.data.writingId
        && request.resource.data.promptId == resource.data.promptId
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likeCount >= 0
        && request.resource.data.commentCount >= 0
        && likeDeltaBackedByLikeDoc(postId)
        && commentCountDeltaAllowed();
    }

    function ownerEditingContent() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.writingId == resource.data.writingId
        && request.resource.data.promptId == resource.data.promptId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // 작성자 본인 또는 관리자(신고 처리)가 삭제할 수 있다.
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (onlyCountersChanged(postId) || ownerEditingContent());
    }

    // 좋아요: 본인 소유 좋아요만 생성/삭제, doc id는 `${postId}_${userId}` 형식으로 중복 방지.
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.resource.data.userId;
      // 본인 좋아요이거나, 이 좋아요가 달린 글을 지우는 중인 글 주인/관리자.
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || postGone(resource.data.postId));
      allow update: if false;
    }

    // 저장(북마크): 본인 소유 저장만 생성/삭제, doc id는 `${postId}_${userId}` 형식으로 중복 방지.
    match /saves/{saveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && saveId == request.resource.data.postId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || postGone(resource.data.postId));
      allow update: if false;
    }

    // 댓글: 로그인 사용자는 읽기/작성 가능. 본인 또는 관리자(신고 처리)가 삭제.
    // 개수 제한이 없는 유일한 표면이라 15초 쿨다운을 규칙에서 강제한다.
    // (좋아요는 문서 ID가 `${postId}_${userId}`라 중복 자체가 불가능해 별도 제한이 필요 없다.)
    // 답글(parentCommentId)도 같은 create 경로를 타므로 별도 규칙이 필요 없다.
    function onlyCommentLikeCountChanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.content == resource.data.content
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount - resource.data.likeCount == 1
            || request.resource.data.likeCount - resource.data.likeCount == -1);
    }

    // 작성자 본인이 댓글 본문만 고칠 때. 좋아요 수·작성자·작성일·글 id·답글 대상은
    // 그대로여야 하고, 본문은 빈 문자열이 아니면서 클라이언트 검증과 같은 길이 제한을 지켜야 한다.
    function ownerEditingCommentContent() {
      return request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.parentCommentId == resource.data.parentCommentId
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 200;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && withinCooldown('comment', 15);
      // 본인 댓글이거나 관리자. 그 외에는 "이미 고아가 된 댓글"만 정리할 수 있다:
      // 글이 사라졌거나(글 삭제), 원댓글이 사라진 답글(댓글 삭제).
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || isAdmin()
            || postGone(resource.data.postId)
            || (resource.data.parentCommentId != null && commentGone(resource.data.parentCommentId)));
      allow update: if isSignedIn() && (onlyCommentLikeCountChanged() || ownerEditingCommentContent());
    }

    // 댓글 좋아요: posts/likes와 동일한 패턴. doc id `${commentId}_${userId}`로 중복 방지.
    match /commentLikes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.commentId + '_' + request.resource.data.userId;
      // 본인 좋아요이거나, 대상 댓글/글이 이미 사라져 고아가 된 좋아요.
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid
            || commentGone(resource.data.commentId)
            || postGone(resource.data.postId));
      allow update: if false;
    }

    // 인앱 알림함: 받는 사람만 읽고, 상태(읽음 여부)만 바꿀 수 있다.
    // 생성은 "행위자 본인 명의로, 자기 자신에게는 보낼 수 없음"만 강제한다 —
    // 좋아요/댓글 자체의 정당성은 이미 posts/comments 규칙이 검증하므로 여기서 다시 보지 않는다.
    function onlyReadFlagChanged() {
      return request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.actorId == resource.data.actorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid && onlyReadFlagChanged();
      // 받은 사람은 자기 알림함을 정리할 수 있고, 보낸 사람(actor)은 계정 삭제 시
      // 자신이 남긴 알림 흔적을 지울 수 있다(다른 사람 알림함을 대신 정리하는 게 아니라
      // "내 행동으로 생긴 기록"만 지우는 것이라 안전하다).
      // 글이 지워지면 그 글을 가리키는 알림도 함께 정리한다(제3자끼리 주고받은
      // 답글 알림처럼 내가 당사자가 아닌 알림도 내 글에 달린 것이면 지워야 한다).
      allow delete: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid
            || resource.data.actorId == request.auth.uid
            || postGone(resource.data.postId));
    }

    // 일별 운영 통계 카운터: 원문 콘텐츠는 담지 않고 개수/uid만 담는다.
    // 로그인한 사용자는 누구나 자신의 활동 시점에 카운터를 올릴 수 있다(likeCount 등 기존
    // 비정규화 카운터와 동일한 신뢰 모델 — 값을 부풀리는 것은 한계로 감수한다).
    // 원문이 없으므로 노출돼도 사생활 문제가 없어, 관리자만 읽을 수 있게 제한한다.
    //
    // 다만 "부풀리기"와 "지우기"는 성격이 다르다. 이 문서에는 원본 로그가 없어
    // 한 번 지워지거나 되돌려지면 그날 지표를 복구할 방법이 아예 없다.
    // 그래서 값이 줄어들거나 필드가 사라지는 방향의 쓰기는 모두 막는다.
    function statsCounterKept(field) {
      return !(field in resource.data)
        || ((field in request.resource.data) && request.resource.data[field] >= resource.data[field]);
    }

    function statsArrayKept(field) {
      return !(field in resource.data)
        || ((field in request.resource.data)
            && request.resource.data[field].size() >= resource.data[field].size());
    }

    // 퍼널 이벤트는 events 맵 안에 이벤트별 카운터로 들어간다.
    // 맵 전체가 통째로 교체되면서 기존 이벤트가 사라지는 것을 막는다.
    function statsEventsKept() {
      return !('events' in resource.data)
        || (('events' in request.resource.data)
            && request.resource.data.events.keys().hasAll(resource.data.events.keys()));
    }

    match /dailyStats/{date} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.date == resource.data.date
        && statsCounterKept('newSignups')
        && statsCounterKept('writingsCount')
        && statsCounterKept('commentsCount')
        && statsCounterKept('likesCount')
        && statsArrayKept('activeUserIds')
        && statsArrayKept('openUserIds')
        && statsEventsKept();
      // 지난 지표는 관리자도 클라이언트에서 지울 이유가 없다(필요하면 Admin SDK로).
      allow delete: if false;
    }

    // 신고: 본인 명의로만 생성. 일반 사용자는 조회할 수 없고 관리자만 확인·처리한다.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      // 관리자는 전부, 신고한 본인은 자기 신고 내역만 볼 수 있다.
      // (submitReport가 중복 신고 확인을 위해 자기 신고를 조회해야 하는데,
      // 지금까지 관리자만 읽을 수 있어서 일반 사용자의 신고 자체가 항상 실패하고 있었다.)
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      // 관리자는 처리 상태(status)만 바꿀 수 있다. 신고 내용 자체는 변조 불가.
      allow update: if isAdmin()
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }
  }
}
