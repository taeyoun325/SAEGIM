rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 관리자 여부. admins/{uid} 문서가 존재하면 관리자다.
    // 이 문서는 Admin SDK(scripts/set-admin.js)로만 만들 수 있어 클라이언트가 스스로 승격할 수 없다.
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 관리자 명단: 아무도 클라이언트에서 쓰지 못한다. 본인 문서만 읽어 관리자인지 확인할 수 있다.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ── 도배 방지 ────────────────────────────────────────────────────────────
    // 보안 규칙은 요청마다 상태가 없으므로, "마지막으로 언제 했는지"를 문서에 남겨 쿨다운을 건다.
    // 핵심은 클라이언트가 시각을 위조하지 못하게 하는 것: 반드시 서버 시각(request.time)만 쓸 수 있다.
    // 액션별로 문서를 따로 둬(단일 필드 전체 덮어쓰기) merge로 인한 판정 모호함을 없앤다.
    // delete를 허용하면 쿨다운 기록을 지워 우회할 수 있으므로 create/update만 연다.
    // (계정 삭제 시 이 문서는 남지만, uid가 재사용되지 않아 문제되지 않는다.)
    match /rateLimits/{uid}/actions/{action} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // 같은 배치(원자적 커밋) 안에서 쿨다운 문서가 "지금"으로 갱신되었고,
    // 직전 기록이 cooldownSeconds보다 오래됐을 때만 통과한다.
    // getAfter = 커밋 후 상태, get = 커밋 전 상태. 첫 시도는 문서가 없으므로 통과한다.
    function withinCooldown(action, cooldownSeconds) {
      let path = /databases/$(database)/documents/rateLimits/$(request.auth.uid)/actions/$(action);
      return getAfter(path).data.at == request.time
        && (!exists(path)
            || get(path).data.at < request.time - duration.value(cooldownSeconds, 's'));
    }
    // ─────────────────────────────────────────────────────────────────────────

    // 글감: 관리자만 생성/수정할 수 있다(관리자 대시보드에서 추가). 클라이언트는 읽기만.
    match /prompts/{promptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 사용자 프로필: 본인만 쓰기, 로그인한 사용자는 공개 프로필 필드를 읽을 수 있음.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // 닉네임 예약: 문서 ID(소문자 닉네임)가 유니크 제약 역할을 한다.
    // 아무도 이미 예약된 문서를 덮어쓸 수 없고, 본인 예약만 해제(계정 삭제 시)할 수 있다.
    match /nicknames/{nicknameKey} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // 글(Writing): 비공개 글은 작성자만 조회, 본인 글만 생성/수정.
    // 생성은 60초 쿨다운. 앱은 글감당 한 편만 쓰게 하지만, 규칙만으로는 그걸 강제할 수 없어
    // (쿼리를 못 하므로) 최소한 스크립트로 대량 생성하는 것을 막는다.
    match /writings/{writingId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && withinCooldown('writing', 60);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 게시물: 공개 콘텐츠이므로 로그인한 사용자는 모두 읽기 가능. 본인만 생성/삭제.
    // 업데이트는 likeCount/commentCount를 ±1 하는 것만 허용하고 나머지 필드는 불변으로 강제한다.

    // ±1 제약만으로는 "좋아요를 누르지 않고 카운트만 1씩 계속 올리는" 조작을 막지 못한다.
    // 좋아요 문서 id는 `${postId}_${uid}`로 정해져 있어 규칙에서 경로를 계산할 수 있으므로,
    // 내 좋아요 문서가 실제로 생겼는지(취소했는지)를 커밋 후 상태(existsAfter)로 확인한다.
    // 앱은 좋아요 문서 쓰기와 카운트 갱신을 같은 트랜잭션에서 하므로 이 검사를 통과한다.
    function likeDeltaBackedByLikeDoc(postId) {
      let likePath = /databases/$(database)/documents/likes/$(postId + '_' + request.auth.uid);
      let delta = request.resource.data.likeCount - resource.data.likeCount;
      return delta == 0
        || (delta == 1 && !exists(likePath) && existsAfter(likePath))
        || (delta == -1 && exists(likePath) && !existsAfter(likePath));
    }

    // 댓글 수는 댓글 문서 id가 자동 생성이라 규칙에서 경로를 알 수 없어 같은 방식으로
    // 검증할 수 없다. 대신 댓글 생성에 15초 쿨다운이 걸려 있어 대량 조작이 제한된다.
    function commentCountDeltaAllowed() {
      return request.resource.data.commentCount - resource.data.commentCount == 1
        || request.resource.data.commentCount - resource.data.commentCount == -1
        || request.resource.data.commentCount == resource.data.commentCount;
    }

    function onlyCountersChanged(postId) {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.writingId == resource.data.writingId
        && request.resource.data.promptId == resource.data.promptId
        && request.resource.data.lines == resource.data.lines
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likeCount >= 0
        && request.resource.data.commentCount >= 0
        && likeDeltaBackedByLikeDoc(postId)
        && commentCountDeltaAllowed();
    }

    function ownerEditingContent() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.writingId == resource.data.writingId
        && request.resource.data.promptId == resource.data.promptId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // 작성자 본인 또는 관리자(신고 처리)가 삭제할 수 있다.
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (onlyCountersChanged(postId) || ownerEditingContent());
    }

    // 좋아요: 본인 소유 좋아요만 생성/삭제, doc id는 `${postId}_${userId}` 형식으로 중복 방지.
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.postId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // 저장(북마크): 본인 소유 저장만 생성/삭제, doc id는 `${postId}_${userId}` 형식으로 중복 방지.
    match /saves/{saveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && saveId == request.resource.data.postId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // 댓글: 로그인 사용자는 읽기/작성 가능. 본인 또는 관리자(신고 처리)가 삭제.
    // 개수 제한이 없는 유일한 표면이라 15초 쿨다운을 규칙에서 강제한다.
    // (좋아요는 문서 ID가 `${postId}_${userId}`라 중복 자체가 불가능해 별도 제한이 필요 없다.)
    // 답글(parentCommentId)도 같은 create 경로를 타므로 별도 규칙이 필요 없다.
    function onlyCommentLikeCountChanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.content == resource.data.content
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.likeCount >= 0
        && (request.resource.data.likeCount - resource.data.likeCount == 1
            || request.resource.data.likeCount - resource.data.likeCount == -1);
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && withinCooldown('comment', 15);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && onlyCommentLikeCountChanged();
    }

    // 댓글 좋아요: posts/likes와 동일한 패턴. doc id `${commentId}_${userId}`로 중복 방지.
    match /commentLikes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && likeId == request.resource.data.commentId + '_' + request.resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // 인앱 알림함: 받는 사람만 읽고, 상태(읽음 여부)만 바꿀 수 있다.
    // 생성은 "행위자 본인 명의로, 자기 자신에게는 보낼 수 없음"만 강제한다 —
    // 좋아요/댓글 자체의 정당성은 이미 posts/comments 규칙이 검증하므로 여기서 다시 보지 않는다.
    function onlyReadFlagChanged() {
      return request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.actorId == resource.data.actorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid && onlyReadFlagChanged();
      // 받은 사람은 자기 알림함을 정리할 수 있고, 보낸 사람(actor)은 계정 삭제 시
      // 자신이 남긴 알림 흔적을 지울 수 있다(다른 사람 알림함을 대신 정리하는 게 아니라
      // "내 행동으로 생긴 기록"만 지우는 것이라 안전하다).
      allow delete: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid || resource.data.actorId == request.auth.uid);
    }

    // 일별 운영 통계 카운터: 원문 콘텐츠는 담지 않고 개수/uid만 담는다.
    // 로그인한 사용자는 누구나 자신의 활동 시점에 카운터를 올릴 수 있다(likeCount 등 기존
    // 비정규화 카운터와 동일한 신뢰 모델 — 값을 부풀리는 것은 한계로 감수한다).
    // 원문이 없으므로 노출돼도 사생활 문제가 없어, 관리자만 읽을 수 있게 제한한다.
    //
    // 다만 "부풀리기"와 "지우기"는 성격이 다르다. 이 문서에는 원본 로그가 없어
    // 한 번 지워지거나 되돌려지면 그날 지표를 복구할 방법이 아예 없다.
    // 그래서 값이 줄어들거나 필드가 사라지는 방향의 쓰기는 모두 막는다.
    function statsCounterKept(field) {
      return !(field in resource.data)
        || ((field in request.resource.data) && request.resource.data[field] >= resource.data[field]);
    }

    function statsArrayKept(field) {
      return !(field in resource.data)
        || ((field in request.resource.data)
            && request.resource.data[field].size() >= resource.data[field].size());
    }

    // 퍼널 이벤트는 events 맵 안에 이벤트별 카운터로 들어간다.
    // 맵 전체가 통째로 교체되면서 기존 이벤트가 사라지는 것을 막는다.
    function statsEventsKept() {
      return !('events' in resource.data)
        || (('events' in request.resource.data)
            && request.resource.data.events.keys().hasAll(resource.data.events.keys()));
    }

    match /dailyStats/{date} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.date == resource.data.date
        && statsCounterKept('newSignups')
        && statsCounterKept('writingsCount')
        && statsCounterKept('commentsCount')
        && statsCounterKept('likesCount')
        && statsArrayKept('activeUserIds')
        && statsArrayKept('openUserIds')
        && statsEventsKept();
      // 지난 지표는 관리자도 클라이언트에서 지울 이유가 없다(필요하면 Admin SDK로).
      allow delete: if false;
    }

    // 신고: 본인 명의로만 생성. 일반 사용자는 조회할 수 없고 관리자만 확인·처리한다.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin();
      // 관리자는 처리 상태(status)만 바꿀 수 있다. 신고 내용 자체는 변조 불가.
      allow update: if isAdmin()
        && request.resource.data.targetType == resource.data.targetType
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }
  }
}
