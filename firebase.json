{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": [
    {
      "site": "saegim",
      "public": "dist",
      "// ignore 주의": "Expo는 폰트/아이콘 에셋을 dist/assets/node_modules/... 경로에 내보낸다. 기본 템플릿의 '**/node_modules/**' 규칙을 쓰면 이 에셋들이 업로드되지 않아 앱이 폰트 로딩에서 멈춘다.",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/_expo/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "// assets 캐시": "폰트/이미지 파일명에 내용 해시가 붙으므로 영구 캐시해도 안전하다. 내용이 바뀌면 파일명이 바뀐다.",
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "// HTML 캐시 주의": "루트('/')는 rewrite로 index.html을 받으므로 '/index.html' 규칙만으로는 캐시 방지가 안 된다. 두 경로 모두 지정해야 새 배포가 즉시 반영된다.",
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "site": "post-it-665d6",
      "public": "dist",
      "// ignore 주의": "Expo는 폰트/아이콘 에셋을 dist/assets/node_modules/... 경로에 내보낸다. 기본 템플릿의 '**/node_modules/**' 규칙을 쓰면 이 에셋들이 업로드되지 않아 앱이 폰트 로딩에서 멈춘다.",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/_expo/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "// assets 캐시": "폰트/이미지 파일명에 내용 해시가 붙으므로 영구 캐시해도 안전하다. 내용이 바뀌면 파일명이 바뀐다.",
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "// HTML 캐시 주의": "루트('/')는 rewrite로 index.html을 받으므로 '/index.html' 규칙만으로는 캐시 방지가 안 된다. 두 경로 모두 지정해야 새 배포가 즉시 반영된다.",
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
